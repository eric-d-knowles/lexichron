Bootstrap: {{ BOOTSTRAP }}
From: {{ BASE }}

# The base image is a build argument so that CI can hand in a locally
# cached copy (--build-arg BOOTSTRAP=localimage --build-arg BASE=python.sif)
# instead of pulling from a registry that rate-limits anonymous pulls.
%arguments
    BOOTSTRAP=docker
    BASE=public.ecr.aws/docker/library/python:3.11-slim-bookworm

# =============================================================================
# lexichron Apptainer image
#
# Builds lexichron from the repository checkout this file lives in, together
# with every runtime dependency that the conda route otherwise installs by
# hand (scripts/setup_nlp_resources.sh): the Enchant C library, Hunspell
# dictionaries, spaCy language models and the NLTK Swadesh corpus. The result
# is a sealed, read-only environment; data paths must be bind-mounted at run
# time (see container/register_kernel.sh and the README).
#
# Build locally from the repository root:
#   apptainer build lexichron.sif container/lexichron.def
#
# The GitHub Actions workflow in .github/workflows/container.yml builds this
# same file on every version tag and publishes it to ghcr.io.
# =============================================================================

%labels
    Author Eric D. Knowles
    Project lexichron
    Source https://github.com/eric-d-knowles/lexichron

# The build is run from the repository root, so "." is the source tree.
%files
    . /opt/lexichron-src
    container/register_kernel.sh /opt/lexichron/register_kernel.sh
    container/new_project.sh /opt/lexichron/new_project.sh
    container/host_bridge.sh /opt/lexichron/host_bridge.sh
    container/install_ui.sh /opt/lexichron/install_ui.sh
    install.sh /opt/lexichron/install.sh
    examples /opt/lexichron/examples
    tests /opt/lexichron/tests
    scripts /opt/lexichron/scripts

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    # -------------------------------------------------------------------------
    # System packages
    #   build-essential  : g++ for the Cython extensions, and kept so that project
#                      environments can pip-install packages that build from source
    #   enchant-2        : spell-checking library used via pyenchant
    #   hunspell-*       : the same dictionary set setup_nlp_resources.sh fetches
    #   libgomp1         : OpenMP runtime for numpy/scipy/gensim wheels
    # -------------------------------------------------------------------------
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        ca-certificates \
        libgomp1 \
        enchant-2 \
        libenchant-2-2 \
        hunspell-en-us \
        hunspell-en-gb \
        hunspell-ru \
        hunspell-fr \
        hunspell-de-de \
        hunspell-es \
        hunspell-it \
        hunspell-pt-pt \
        hunspell-pt-br \
        hunspell-nl

    # -------------------------------------------------------------------------
    # Python: lexichron and its dependencies
    # -------------------------------------------------------------------------
    python -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # Remove any compiled artifacts that may have been checked in, so the
    # extensions are always built fresh against this image's Python.
    find /opt/lexichron-src/src -name '*.so' -delete
    find /opt/lexichron-src/src -name '*.o' -delete
    find /opt/lexichron-src/src -type d -name build -prune -exec rm -rf {} +

    python -m pip install --no-cache-dir "/opt/lexichron-src[ui]"

    # gensim's corpus_file reader, rebuilt free of the GIL (scripts/patch_gensim.py
    # explains): on n-gram corpora, where a line is five tokens, the stock build
    # re-takes the GIL for every line and a model cannot use more than a few
    # cores. The wheel ships its Cython sources; the word2vec/doc2vec/fastText
    # extensions are recompiled in place with the Cython gensim 4.4's own sources
    # were generated with, used for this step only.
    python -m pip install --no-cache-dir --target /tmp/cython-for-gensim "Cython==3.1.3"
    PYTHONPATH=/tmp/cython-for-gensim python /opt/lexichron-src/scripts/patch_gensim.py
    rm -rf /tmp/cython-for-gensim
    chmod 755 /opt/lexichron/register_kernel.sh /opt/lexichron/new_project.sh /opt/lexichron/host_bridge.sh /opt/lexichron/install_ui.sh

    # Notebook execution without a browser (used for batch runs via nbconvert),
    # and pytest so the image can run the package's test suite.
    python -m pip install --no-cache-dir nbconvert pytest

    # -------------------------------------------------------------------------
    # Evaluation datasets for the hyperparameter search (SimLex-999,
    # WordSim-353, Google's analogy questions), from gensim's repository at a
    # fixed tag; checked for shape, with their checksums recorded in
    # SOURCES.md. The stage looks here first (LEXICHRON_DATA_DIR).
    # -------------------------------------------------------------------------
    mkdir -p /opt/lexichron/data
    for f in simlex999.txt wordsim353.tsv questions-words.txt; do
        curl -fsSL --retry 5 --retry-delay 10 -o "/opt/lexichron/data/$f" \
            "https://raw.githubusercontent.com/piskvorky/gensim/4.3.3/gensim/test/test_data/$f"
    done
    # the VADER lexicon (human valence ratings; MIT licence) is the yardstick
    # for the search's axis scores
    curl -fsSL --retry 5 --retry-delay 10 -o /opt/lexichron/data/vader_lexicon.txt \
        "https://raw.githubusercontent.com/cjhutto/vaderSentiment/44fc044cd877310ee8278a0eadf34bcd50d41d06/vaderSentiment/vader_lexicon.txt"
    python /opt/lexichron/scripts/check_datasets.py /opt/lexichron/data

    # -------------------------------------------------------------------------
    # spaCy models (the list in src/ngramprep/__init__.py). Baking them in
    # means the import-time auto-download never runs inside the image, which
    # matters on compute nodes without outbound network access.
    # -------------------------------------------------------------------------
    for model in en_core_web_sm zh_core_web_sm fr_core_news_sm de_core_news_sm \
                 it_core_news_sm ru_core_news_sm es_core_news_sm; do
        python -m spacy download "$model"
    done

    # -------------------------------------------------------------------------
    # NLTK Swadesh list (model alignment)
    # -------------------------------------------------------------------------
    # NLTK (3.9.2+) refuses to install into, or load from, a directory other
    # accounts can write to, and fakeroot builds create directories
    # group-writable: make it private before the download, and check the
    # download succeeded (nltk.download() reports failure by returning False)
    mkdir -p /usr/local/share/nltk_data
    chmod -R go-w /usr/local/share/nltk_data
    python -c "import nltk, sys; sys.exit(0 if nltk.download('swadesh', download_dir='/usr/local/share/nltk_data') else 1)"
    chmod -R go-w /usr/local/share/nltk_data

    # -------------------------------------------------------------------------
    # Sanity checks: fail the build if any resource is missing.
    # -------------------------------------------------------------------------
    export PYENCHANT_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libenchant-2.so.2
    export NLTK_DATA=/usr/local/share/nltk_data
    python - <<'EOF'
import enchant, rocks_shim, spacy, gensim
from nltk.corpus import swadesh
langs = sorted(enchant.list_languages())
for required in ["en_US", "ru_RU", "fr_FR", "de_DE", "es_ES", "it_IT"]:
    assert required in langs, f"missing hunspell dictionary {required}: {langs}"
assert swadesh.words("en")[:1]
import ngramprep.ngram_filter.filters.core_cy
import ngramprep.utilities.count_items
import daviesprep.davies_filter.filters.core_cy
print("enchant languages:", langs)
print("all runtime resources present")
EOF

    # -------------------------------------------------------------------------
    # Clean up (the compiler and git stay, for project environments)
    # -------------------------------------------------------------------------
    apt-get clean
    rm -rf /var/lib/apt/lists/* /opt/lexichron-src /root/.cache

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # pyenchant: point at the system Enchant library and dictionary directory
    export PYENCHANT_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libenchant-2.so.2
    export DICPATH=/usr/share/hunspell
    export LEXICHRON_DATA_DIR=/opt/lexichron/data
    export NLTK_DATA=/usr/local/share/nltk_data
    # Keep BLAS from oversubscribing when the pipelines spawn worker processes
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}
    export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-1}
    export MKL_NUM_THREADS=${MKL_NUM_THREADS:-1}
    # Never write caches inside the (read-only) image
    export XDG_CACHE_HOME=${XDG_CACHE_HOME:-/tmp/lexichron-cache}
    export MPLCONFIGDIR=${MPLCONFIGDIR:-/tmp/lexichron-cache/matplotlib}

%runscript
    # `apptainer run lexichron.sif` behaves like `python`:
    #   apptainer run lexichron.sif script.py
    #   apptainer run lexichron.sif -m jupyter nbconvert --execute nb.ipynb
    exec python "$@"

%test
    python -c "import ngramprep, daviesprep, train, analyze; print('lexichron import OK')"
    lexichron --version
    lexichron acquire /opt/lexichron/examples/lexichron.yaml --dry-run
    # The unit tests are run by the CI workflow with `apptainer exec ... pytest`,
    # because a failing %test section does not fail `apptainer build`/`test`.
    bash -n /opt/lexichron/register_kernel.sh /opt/lexichron/new_project.sh /opt/lexichron/host_bridge.sh /opt/lexichron/install_ui.sh
    python -c "import textual, lexichron.ui.app"
    # A project environment can be created and sees lexichron through the image
    python -m venv --system-site-packages /tmp/lexichron-test-venv
    /tmp/lexichron-test-venv/bin/python -c "import ngramprep; print('venv sees lexichron')"
    rm -rf /tmp/lexichron-test-venv

# -----------------------------------------------------------------------------
# App: register this image as a Jupyter kernel
#   apptainer run --app register-kernel lexichron-<version>.sif [--bind DIR ...]
# -----------------------------------------------------------------------------
%apprun register-kernel
    unset BASH_ENV ENV; exec bash /opt/lexichron/register_kernel.sh "$@"

%apphelp register-kernel
    Register this image as a Jupyter kernel for JupyterLab, Positron or VS Code:

        apptainer run --app register-kernel lexichron-<version>.sif

    Options: --bind DIR (repeatable), --name NAME, --display "NAME".
    Then restart Jupyter / reload the editor window and pick
    "Python (lexichron <version>)" from the kernel menu.

# -----------------------------------------------------------------------------
# App: create a project environment (venv on top of the image) plus its kernel
#   apptainer run --app new-project lexichron-<version>.sif /path/to/project
# -----------------------------------------------------------------------------
%apprun new-project
    unset BASH_ENV ENV; exec bash /opt/lexichron/new_project.sh "$@"

# -----------------------------------------------------------------------------
# App: terminal user interface (runs inside the container; for Slurm actions
# start it through the project's .venv/lexichron-ui launcher instead, which
# also runs the host bridge)
#   apptainer run --app ui lexichron-<version>.sif /path/to/project/lexichron.yaml
# -----------------------------------------------------------------------------
%apprun ui
    unset BASH_ENV ENV; exec lexichron ui "$@"

%apphelp ui
    Open the terminal user interface (optionally on a settings file):

        apptainer run --app ui lexichron-<version>.sif [lexichron.yaml]

    From inside the container the UI cannot submit Slurm jobs. For that, run
    `apptainer run --app install lexichron.sif` once (the README's one-line
    installer does this) and start the UI with the `lexichron-ui` command it
    installs, which also runs a small host helper.

# App: install host-side `lexichron` and `lexichron-ui` commands into ~/.local/bin
# (install.sh at the repository root pulls the image and calls this)
%apprun install
    unset BASH_ENV ENV; exec bash /opt/lexichron/install_ui.sh "$@"

%apphelp install
    Write `lexichron` and `lexichron-ui` commands into ~/.local/bin that run
    inside this image (the UI one also starts the Slurm host helper):

        apptainer run --app install lexichron-<version>.sif
        lexichron-ui                      # then, from anywhere

    Most people never run this by hand: the one-line installer in the README
    pulls the image and calls it.

# Older name, kept for compatibility
%apprun install-ui
    unset BASH_ENV ENV; exec bash /opt/lexichron/install_ui.sh "$@"

%apphelp install-ui
    Same as `install`.

%apphelp new-project
    Create a project environment: a virtual environment in <project>/.venv that
    inherits lexichron from this image and takes your own packages, plus a
    Jupyter kernel for it:

        apptainer run --app new-project lexichron-<version>.sif /path/to/project

    Then pick "Python (<project> | lexichron <version>)" from the kernel menu
    and install packages with  %pip install <package>  in a notebook, or with
        apptainer exec lexichron-<version>.sif /path/to/project/.venv/bin/pip install <package>

%help
    lexichron: scalable tools for temporal linguistic analysis.

    This image contains lexichron and all of its runtime dependencies.
    Data directories on the host must be bind-mounted, e.g.:

        apptainer exec --bind /scratch lexichron.sif python my_script.py

    To use the image as a Jupyter kernel (no clone of the repository needed):

        apptainer run --app register-kernel lexichron.sif

    To create a project environment that adds your own packages on top:

        apptainer run --app new-project lexichron.sif /path/to/project

    Then pick the kernel from the kernel menu. Each app has its own help:
    apptainer run-help --app new-project lexichron.sif
